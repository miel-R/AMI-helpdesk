{
    "flow": {
        "name": "IT Support Flow",
        "department": "it",
        "extends": "base",
        "initial_questions": [
            {
                "id": "greeting",
                "question": "👨‍💻 IT Support: Good day! What is your name?",
                "type": "text",
                "required": true,
                "next": "issue_type"
            },
            {
                "id": "issue_type",
                "question": "What IT issue are you facing?",
                "type": "select",
                "options": [
                    "Computer/Laptop Issue",
                    "Network/Internet Problem",
                    "Email/Outlook Issue",
                    "Software/Application Error",
                    "Password Reset",
                    "Access/Permission Request",
                    "Printer/Scanner Issue",
                    "Other"
                ],
                "required": true,
                "next": "description"
            },
            {
                "id": "description",
                "question": "Please describe the issue in detail:",
                "type": "text",
                "required": true,
                "next": "troubleshooting"
            },
            {
                "id": "troubleshooting",
                "question": "Have you tried any troubleshooting steps? If yes, please list them:",
                "type": "text",
                "required": false,
                "next": "urgency"
            },
            {
                "id": "urgency",
                "question": "How urgent is this issue?",
                "type": "select",
                "options": [
                    "Critical - Cannot work at all",
                    "High - Affecting my work",
                    "Medium - Can work around",
                    "Low - Can wait"
                ],
                "required": true,
                "next": "completion"
            }
        ],
        "completion_message": "✅ IT Ticket submitted! Our IT team will assist you shortly."
    }
}