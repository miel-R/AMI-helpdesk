# Company
COMPANY_NAME=Amertron Corporation

# Server
PORT=3978
NODE_ENV=development

# ─────────────────────────────────────────────
# Bot Framework / Teams credentials (optional locally; required in production)
# NOTE: prefer a SECRET_ prefixed copy in env/.env.dev.user — e.g. SECRET_BOT_PASSWORD
# ─────────────────────────────────────────────
BOT_ID=
BOT_PASSWORD=
BOT_ENDPOINT=

# ─────────────────────────────────────────────
# AI Provider Selection
# Set AI_PROVIDER to one of: gemini | openai | azure
# If not set, auto-detects based on which key is present.
# Priority order (auto): Gemini → OpenAI → Azure OpenAI
# ─────────────────────────────────────────────
AI_PROVIDER=gemini

# --- Option 1: Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash-lite

# --- Option 2: OpenAI (ChatGPT) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- Option 3: Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=your_deployment_name

# Image handling
MAX_IMAGE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Performance
MAX_CONCURRENT=10
QUEUE_TIMEOUT=30000
# Idle time (ms) before a user's conversation is ended — 120000 = 2 minutes
SESSION_TIMEOUT=120000
RATE_LIMIT_WINDOW=60000
MAX_REQUESTS_PER_WINDOW=10

# Cache
CACHE_TTL=3600
MAX_CACHE_SIZE=1000

# Ticket
TICKET_PREFIX=AMR
NOTIFY_ON_TICKET=true

# ─────────────────────────────────────────────
# Reply control & group chat approval
# These are FIRST-RUN SEEDS only. After the first start,
# access-control.json takes over and is managed at runtime via
# admin commands: /allow, /disallow, /allowlist, /addadmin,
# /removeadmin, /admins, /approve, /restart
# ─────────────────────────────────────────────
# Comma-separated user IDs allowed to trigger Ami (default-deny when empty)
ALLOWED_USER_IDS=
# Comma-separated administrator user IDs (can run admin commands)
ADMIN_USER_IDS=
# Optional pre-approved conversation IDs
APPROVED_CONVERSATION_IDS=

# ─────────────────────────────────────────────
# Confidentiality
# ─────────────────────────────────────────────
# Extra sensitive phrases to block, comma-separated (added to the built-in defaults)
SENSITIVE_TOPICS=